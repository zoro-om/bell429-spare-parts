/*
  Cloudflare Pages/Workers security headers.
  Keep this file at the project root if using Pages.
*/
 /*
  Note: CSP should be tightened after verifying every external image/script/font
  used by the existing UI. The Worker also sends the same baseline headers.
*/
 / {
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
}
